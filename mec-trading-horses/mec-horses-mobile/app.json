{
  "expo": {
    "name": "MEC HORSES",
    "slug": "mec-horses",
    "scheme": "mechorses",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "https://raw.githubusercontent.com/mectrading77-MMG/mec-trading-horses/main/mec-trading-horses/mec-trading/public/brand/logo-compact.png",
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mechorses.app"
    },
    "android": {
      "package": "com.mechorses.app",
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "https://raw.githubusercontent.com/mectrading77-MMG/mec-trading-horses/main/mec-trading-horses/mec-trading/public/brand/logo-compact-light.png"
      }
    },
    "extra": {
      "catalogApiUrl": "https://www.mechorses.com/api/public/horses"
